---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressTracker from '../components/ProgressTracker.astro';
import TimelineBadge from '../components/TimelineBadge.astro';

const baseUrl = import.meta.env.BASE_URL;

const volumes = [
  {
    num: 1,
    roman: 'I',
    title: 'Prologue & First Assignments',
    range: 'Chapters 01–10',
    desc: 'The fateful choice at Lazvil Hills. Inception of Standard History (Specint) and Alternate History (Rosch Brigade), Sand Fortress infiltration, and first Historia nodes.',
    stats: { chapters: 10, nodes: 14, endings: 2, sidequests: 5, bosses: 3 },
    href: `${baseUrl}walkthrough/volume-1/`,
    borderClass: 'timeline-border-prologue'
  },
  {
    num: 2,
    roman: 'II',
    title: 'Specint Espionage & Underground Passages',
    range: 'Chapters 11–20',
    desc: 'Deep covert operations across Gran Plain, infiltrating Granorg via the dangerous Underground Waterways, and early boss clashes with the Shadow and Granorg guards.',
    stats: { chapters: 10, nodes: 18, endings: 3, sidequests: 6, bosses: 4 },
    href: `${baseUrl}walkthrough/volume-2/`,
    borderClass: 'timeline-border-standard'
  },
  {
    num: 3,
    roman: 'III',
    title: 'Celestia Alliance & Fortress Battles',
    range: 'Chapters 21–30',
    desc: 'Rosch Brigade defense at the Sand Fortress, venturing into the mystical beastkind realm of Celestia, and palace uprisings in Granorg.',
    stats: { chapters: 10, nodes: 20, endings: 4, sidequests: 7, bosses: 5 },
    href: `${baseUrl}walkthrough/volume-3/`,
    borderClass: 'timeline-border-alternate'
  },
  {
    num: 4,
    roman: 'IV',
    title: 'Desert Wastelands & The Wandering City',
    range: 'Chapters 31–40',
    desc: 'Journey through Cornet Village, Judgement Cliff confrontations, and entering the independent desert haven of Cygnus.',
    stats: { chapters: 10, nodes: 22, endings: 3, sidequests: 8, bosses: 4 },
    href: `${baseUrl}walkthrough/volume-4/`,
    borderClass: 'timeline-border-standard'
  },
  {
    num: 5,
    roman: 'V',
    title: 'Ruins of Holff & The Forgia Pact',
    range: 'Chapters 41–50',
    desc: 'Ancient secrets of Holff Ruins, treacherous traversals of Abyssia Forest, and securing the alliance with the Gutsize beastkind of Forgia.',
    stats: { chapters: 10, nodes: 25, endings: 4, sidequests: 6, bosses: 5 },
    href: `${baseUrl}walkthrough/volume-5/`,
    borderClass: 'timeline-border-alternate'
  },
  {
    num: 6,
    roman: 'VI',
    title: 'The Underground Lab & Puppet Masters',
    range: 'Chapters 51–60',
    desc: 'Unmasking Hugo’s dark experiments in the Underground Lab, liberating Skalla, and the climactic battles against thaumatech monstrosities.',
    stats: { chapters: 10, nodes: 28, endings: 5, sidequests: 9, bosses: 6 },
    href: `${baseUrl}walkthrough/volume-6/`,
    borderClass: 'timeline-border-alternate'
  },
  {
    num: 7,
    roman: 'VII',
    title: 'The Convergent Climax & Imperial Ruins',
    range: 'Chapters 61–66',
    desc: 'The convergence of Standard and Alternate Histories, the descent into Imperial Ruins and the Royal Hall, and the final battle for the fate of Vainqueur.',
    stats: { chapters: 6, nodes: 32, endings: 6, sidequests: 8, bosses: 7 },
    href: `${baseUrl}walkthrough/volume-7/`,
    borderClass: 'timeline-border-final'
  }
];
---

<BaseLayout title="The White Chronicle Compendium" description="The ultimate 100% guide, dual timeline navigation, 3x3 battle grid strategies, and 236 Historia node completion list for Radiant Historia.">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>Complete 100% Strategy Compendium</span>
        </div>

        <div class="hero-logo-wrap">
          <img src={`${baseUrl}assets/logo.png`} alt="Radiant Historia" class="hero-logo" width="340" height="102" loading="eager" />
        </div>

        <h1 class="hero-title">
          Master the Flow of Time Across <span class="text-gold">Vainqueur</span>
        </h1>

        <p class="hero-subtitle">
          Unlock all <strong>236 White Chronicle Nodes</strong>, navigate the dual timelines of <strong>Standard History</strong> and <strong>Alternate History</strong>, and master tactical 3×3 grid combat with zero missables.
        </p>

        <div class="hero-cta-group">
          <a href="#volumes" class="btn btn-primary">
            <span>Explore Walkthrough</span>
            <span class="btn-arrow">↓</span>
          </a>
          <a href={`${baseUrl}nodes/`} class="btn btn-secondary">
            <span>236 Node Tracker</span>
            <span class="btn-arrow">→</span>
          </a>
          <a href={`${baseUrl}introduction/`} class="btn btn-tertiary">
            <span>Battle Tactics</span>
            <span class="btn-arrow">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="container main-hub-container">
    <!-- Real-time Progress Dashboard -->
    <ProgressTracker />

    <!-- Walkthrough Volumes Section -->
    <section id="volumes" class="volumes-section">
      <div class="section-heading-wrap">
        <div class="section-eyebrow">Seven Volume Compendiums</div>
        <h2 class="section-title">Complete 66-Chapter Walkthrough</h2>
        <p class="section-desc">
          Every chapter features full tactical briefings, recommended levels, enemy weaknesses, ASCII area maps, shop matrices, boss strategies, sidequest logs, and possible history warnings.
        </p>
      </div>

      <div class="volumes-grid">
        {volumes.map((vol) => (
          <article class={`glass-card volume-card ${vol.borderClass}`}>
            <div class="volume-card-top">
              <div class="vol-num-pill">Volume {vol.roman}</div>
              <span class="vol-range-tag">{vol.range}</span>
            </div>

            <h3 class="vol-card-title">
              <a href={vol.href}>{vol.title}</a>
            </h3>

            <p class="vol-card-desc">{vol.desc}</p>

            <div class="vol-stats-bar">
              <span title="Chapters">📖 {vol.stats.chapters} Ch.</span>
              <span title="Historia Nodes">✨ {vol.stats.nodes} Nodes</span>
              <span title="Major Bosses">💀 {vol.stats.bosses} Bosses</span>
              <span title="Sidequests">📜 {vol.stats.sidequests} Quests</span>
            </div>

            <a href={vol.href} class="vol-btn">
              <span>Read Volume {vol.roman}</span>
              <span class="arrow">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Compendium Hub Modules Grid -->
    <section class="compendium-modules-section">
      <div class="section-heading-wrap">
        <div class="section-eyebrow">Comprehensive Knowledge Base</div>
        <h2 class="section-title">Specialized Compendium Reference</h2>
      </div>

      <div class="modules-grid">
        <a href={`${baseUrl}nodes/`} class="module-card glass-card">
          <span class="mod-icon">✨</span>
          <h3 class="mod-title">236 Historia Node Tracker</h3>
          <p class="mod-desc">Complete interactive checklist for all 236 White Chronicle nodes, bad endings, and sidequest initiation/resolutions.</p>
          <span class="mod-link">Access Node Matrix →</span>
        </a>

        <a href={`${baseUrl}introduction/`} class="module-card glass-card">
          <span class="mod-icon">⚔️</span>
          <h3 class="mod-title">Combat Systems &amp; Tactics</h3>
          <p class="mod-desc">Master turn manipulation, Trans-turn swapping, Mana Bursts, grid push combos, and status ailment vulnerabilities.</p>
          <span class="mod-link">View Systems Guide →</span>
        </a>

        <a href={`${baseUrl}abilities/`} class="module-card glass-card">
          <span class="mod-icon">⚡</span>
          <h3 class="mod-title">Character Abilities &amp; Skills</h3>
          <p class="mod-desc">Level progression tables and sidequest skill scrolls for Stocke, Raynie, Marco, Rosch, Aht, Gafka, and Eruca.</p>
          <span class="mod-link">View Skill Lists →</span>
        </a>

        <a href={`${baseUrl}credits/`} class="module-card glass-card">
          <span class="mod-icon">📜</span>
          <h3 class="mod-title">Credits &amp; Acknowledgments</h3>
          <p class="mod-desc">Original guide authorship by Henri "HC" Bailly, GameFAQs community contributors, and copyright information.</p>
          <span class="mod-link">View Credits →</span>
        </a>
      </div>
    </section>

    <!-- Dual Timelines Explainer Card -->
    <section class="glass-card timeline-overview-card">
      <div class="card-header">
        <span class="card-icon">⏳</span>
        <h2 class="card-title">The Dual Timelines of Radiant Historia</h2>
      </div>

      <p class="overview-desc">
        At the Lazvil Hills crossroad, Stocke receives **The White Chronicle**, granting the power to travel freely between time nodes. The continent of Vainqueur is split between two divergent historical trajectories:
      </p>

      <div class="timeline-pillars-grid">
        <div class="timeline-pillar pillar-standard">
          <div class="pillar-header">
            <TimelineBadge timeline="Standard" />
            <span class="pillar-role">Specint Espionage Path</span>
          </div>
          <p class="pillar-text">
            Under Chief Heiss, Stocke operates as a Special Intelligence agent, conducting covert reconnaissance, infiltration, and espionage missions behind enemy lines.
          </p>
          <ul class="pillar-highlights">
            <li>🔹 Stealth infiltration of Granorg through Underground Waterways</li>
            <li>🔹 Uncovering royal conspiracies and assassination plots</li>
            <li>🔹 Desert alliance with Garland in Cygnus</li>
          </ul>
        </div>

        <div class="timeline-pillar pillar-alternate">
          <div class="pillar-header">
            <TimelineBadge timeline="Alternate" />
            <span class="pillar-role">Rosch Brigade Military Path</span>
          </div>
          <p class="pillar-text">
            Stocke joins his best friend Rosch on the frontlines, commanding soldiers in direct warfare against the oppressive Granorg army and magitech warmachines.
          </p>
          <ul class="pillar-highlights">
            <li>🔸 Frontline defense and fortress sieges</li>
            <li>🔸 Forging treaties with Beastkind in Celestia and Forgia</li>
            <li>🔸 Exposing Hugo’s bio-thaumatech laboratory</li>
          </ul>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding: clamp(3rem, 6vw, 5.5rem) 0 clamp(2rem, 4vw, 3.5rem) 0;
    text-align: center;
    position: relative;
  }

  .hero-container {
    max-width: 1000px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid var(--gold-border);
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gold-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--gold-primary);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--gold-glow);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0.25rem auto 1.5rem auto;
  }

  .hero-logo {
    max-width: 380px;
    width: 85%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 20px rgba(251, 191, 36, 0.4));
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .hero-logo:hover {
    transform: scale(1.02);
    filter: drop-shadow(0 0 26px rgba(251, 191, 36, 0.6));
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    color: var(--text-bright);
    line-height: 1.15;
    margin-bottom: 1.25rem;
    text-shadow: 0 0 24px rgba(251, 191, 36, 0.25);
  }

  .text-gold {
    color: var(--gold-primary);
    background: linear-gradient(135deg, #fffbeb, #fbbf24 60%, #b45309);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin: 0 auto 2.25rem auto;
    max-width: 800px;
  }

  .hero-subtitle strong {
    color: var(--text-bright);
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: var(--transition);
    cursor: pointer;
  }

  .btn-primary {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #06090f;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4);
    border: none;
  }

  .btn-primary:hover {
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.6);
  }

  .btn-secondary {
    background: rgba(6, 182, 212, 0.15);
    color: var(--mana-cyan);
    border: 1px solid rgba(6, 182, 212, 0.4);
  }

  .btn-secondary:hover {
    background: rgba(6, 182, 212, 0.25);
    color: #fff;
    transform: translateY(-2px);
  }

  .btn-tertiary {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-tertiary:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--gold-primary);
    border-color: var(--gold-border);
    transform: translateY(-2px);
  }

  /* Main Hub Container */
  .main-hub-container {
    padding-bottom: 4rem;
  }

  /* Timeline Overview Card */
  .timeline-overview-card {
    margin: 2.5rem 0;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.6rem;
  }

  .card-icon {
    font-size: 1.4rem;
  }

  .card-title {
    font-size: 1.4rem;
    color: var(--gold-primary);
    margin: 0;
  }

  .overview-desc {
    color: var(--text-secondary);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .timeline-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .timeline-pillar {
    background: rgba(6, 9, 15, 0.6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .pillar-standard {
    border-left: 4px solid var(--timeline-standard);
  }

  .pillar-alternate {
    border-left: 4px solid var(--timeline-alternate);
  }

  .pillar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-ui);
  }

  .pillar-role {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .pillar-text {
    font-size: 1.05rem;
    color: var(--text-primary);
    line-height: 1.6;
  }

  .pillar-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-family: var(--font-ui);
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  /* Volumes Section */
  .volumes-section {
    margin: 3.5rem 0;
  }

  .section-heading-wrap {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    color: var(--gold-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    color: var(--text-bright);
    margin-bottom: 0.6rem;
  }

  .section-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .volumes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .volume-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    border-left-width: 4px;
    transition: var(--transition);
  }

  .volume-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold-border);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8);
  }

  .timeline-border-prologue { border-left-color: var(--timeline-prologue); }
  .timeline-border-standard { border-left-color: var(--timeline-standard); }
  .timeline-border-alternate { border-left-color: var(--timeline-alternate); }
  .timeline-border-final { border-left-color: var(--timeline-final); }

  .volume-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-ui);
    margin-bottom: 0.75rem;
  }

  .vol-num-pill {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--gold-primary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .vol-range-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .vol-card-title {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .vol-card-title a {
    color: var(--text-bright);
    text-decoration: none;
  }

  .vol-card-title a:hover {
    color: var(--gold-primary);
  }

  .vol-card-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .vol-stats-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.75rem;
    margin-bottom: 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.1);
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .vol-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 0.65rem 1rem;
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition);
  }

  .vol-btn:hover {
    background: rgba(251, 191, 36, 0.12);
    border-color: var(--gold-border);
    color: var(--gold-primary);
  }

  /* Compendium Modules */
  .compendium-modules-section {
    margin: 4rem 0 2rem 0;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .module-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    text-decoration: none;
    transition: var(--transition);
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: var(--gold-border);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
  }

  .mod-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .mod-title {
    font-size: 1.2rem;
    color: var(--text-bright);
    margin-bottom: 0.5rem;
  }

  .module-card:hover .mod-title {
    color: var(--gold-primary);
  }

  .mod-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .mod-link {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--gold-primary);
  }
</style>

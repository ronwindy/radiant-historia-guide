  {
    "id": "ch59",
    "number": 59,
    "title": "Granorg (Alternate Chapter 6)",
    "timeline": "Alternate"
  },
  {
    "id": "ch60",
    "number": 60,
    "title": "Underground Waterway (Alternate Chapter 6)",
    "timeline": "Alternate"

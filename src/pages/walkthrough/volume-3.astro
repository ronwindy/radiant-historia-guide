---
import WalkthroughLayout from '../../layouts/WalkthroughLayout.astro';
import ChapterCard from '../../components/ChapterCard.astro';
import TacticalBriefing from '../../components/TacticalBriefing.astro';
import AsciiMap from '../../components/AsciiMap.astro';
import BossCard from '../../components/BossCard.astro';
import ShopMatrix from '../../components/ShopMatrix.astro';
import Callout from '../../components/Callout.astro';
import Tag from '../../components/Tag.astro';

const baseUrl = import.meta.env.BASE_URL;

const quickJumps = [
  {
    "id": "ch21",
    "number": 21,
    "title": "Sand Fortress (Alternate Chapter 1)",
    "timeline": "Alternate"
  },
  {
    "id": "ch22",
    "number": 22,
    "title": "Sand Fortress (Alternate Chapter 2)",
    "timeline": "Alternate"
  },
  {
    "id": "ch23",
    "number": 23,
    "title": "Gran Plain (Alternate Chapter 2)",
    "timeline": "Alternate"
  },
  {
    "id": "ch24",
    "number": 24,
    "title": "Alistel (Alternate Chapter 2)",
    "timeline": "Alternate"
  },
  {
    "id": "ch25",
    "number": 25,
    "title": "Celestia (Alternate Chapter 3)",
    "timeline": "Alternate"
  },
  {
    "id": "ch26",
    "number": 26,
    "title": "Lazvil Hills (Alternate Chapter 3)",
    "timeline": "Alternate"
  },
  {
    "id": "ch27",
    "number": 27,
    "title": "Alistel (Alternate Chapter 3)",
    "timeline": "Alternate"
  },
  {
    "id": "ch28",
    "number": 28,
    "title": "Celestia (Alternate Chapter 3)",
    "timeline": "Alternate"
  },
  {
    "id": "ch29",
    "number": 29,
    "title": "Granorg Palace (Standard Chapter 2)",
    "timeline": "Standard"

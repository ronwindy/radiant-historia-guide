import ChapterCard from '../../components/ChapterCard.astro';
import TacticalBriefing from '../../components/TacticalBriefing.astro';
import AsciiMap from '../../components/AsciiMap.astro';
import BossCard from '../../components/BossCard.astro';
import ShopMatrix from '../../components/ShopMatrix.astro';
import Callout from '../../components/Callout.astro';
import Tag from '../../components/Tag.astro';

const baseUrl = import.meta.env.BASE_URL;

const quickJumps = [
  {
    "id": "ch61",
    "number": 61,
    "title": "Granorg Palace (Alternate Chapter 6)",
    "timeline": "Alternate"
  },
  {
    "id": "ch62",
    "number": 62,
    "title": "Alistel (Alternate Chapter 6)",
    "timeline": "Alternate"
  },
  {
    "id": "ch63",
    "number": 63,
    "title": "Underground Lab (Alternate Chapter 6)",
    "timeline": "Alternate"
  },
  {
    "id": "ch64",
    "number": 64,
    "title": "Granorg (Alternate Final Chapter)",
    "timeline": "Alternate"
  },
  {
    "id": "ch65",
    "number": 65,
    "title": "Imperial Ruins (Alternate Final Chapter)",
    "timeline": "Alternate"
  },
  {
    "id": "ch66",
    "number": 66,
    "title": "Royal Hall (Standard Final Chapter)",
    "timeline": "Standard"
  }
];

const stats = {
  chapters: 6,
  nodes: 14,
  endings: 6,
  sidequests: 8,
  bosses: 14
};

const prevVol = { num: 6, title: 'Granorg Liberation & Shadow of Dias', href: `${baseUrl}walkthrough/volume-6/` };
const nextVol = undefined;
---

<WalkthroughLayout
  volume={7}
  volumeTitle="The Final Battle & True Epilogue"
  chapterRange="Chapters 61–66"
  description="Infiltrating the Royal Hall, unraveling Heiss's destiny, confronting the Black Chronicle, and sealing the ultimate fate of Vainqueur."
  stats={stats}
  quickJumps={quickJumps}
  prevVol={prevVol}
  nextVol={nextVol}
>

  <!-- Chapter 61 -->
  <ChapterCard
    id="ch61"
    number={61}
    title="Granorg Palace (Alternate Chapter 6)"
    timeline="Alternate"
  >
    <TacticalBriefing
      level="61" party="Stocke, Eruca, Gafka" enemies={[{"name": "Alistel Officer"}, {"name": "Cannon", "weakness": "Fire"}, {"name": "Heavy Granorgite", "weakness": "Lightning"}, {"name": "Master Assassin", "weakness": "Sleep"}, {"name": "Thaumachine", "weakness": "Lightning"}]}
    />

    <div class="chapter-walkthrough-prose">
      <AsciiMap>
<pre>Meeting   Underground   Underground
                         Room       Library        Cell
        Audience  _       ___      ______         ____
          Hall   | |     /   \    |   _  |       |  __|     S - Save Point
                 | |     |   |    |S | | |       | |        A - Connects to A
                 | |     \  _/    |__|
    Palace               / /           | |_______| |
   Interior    __| |_                  |____ S ____|
      ____    /      \__| |                 | |
     |    |  |          __|  Hall          _| |
     |  _ |  |  _____  |                  |   |__
     | | \ \ | |     | |  ____            |______A
 ____                    A___ |
|  S | | | |_| |_____| |_/ ___|         Underground
|      | |______     _____/               Passage
|______|       _|   |_
              |       |  Hall
Training      |_     _|
  Area          |   |</pre>
      </AsciiMap>
      <p>For most of this area, I would recommend using <Tag type="char">Gafka</Tag>. However, I would replace him with <Tag type="char">Aht</Tag> at the beginning, equip her with Raynie&#x27;s <Tag type="acc">Thauma Charms</Tag>, and equip <Tag type="char">Stocke</Tag> with the <Tag type="armor">Gospel Armor</Tag>. Head left two screens to the library and talk to <Tag type="char">Eruca</Tag> to make your next move.</p>
      <BossCard name="Heavy Thaumaton" weakness="Lightning">
        <p><strong>Strategy:</strong> Lay a <Tag type="skill">Volt Star Trap</Tag> behind him, have <Tag type="char">Eruca</Tag> use <Tag type="skill">Push Assault</Tag>, and <Tag type="char">Stocke</Tag> <Tag type="skill">Steal</Tag> a <Tag type="weapon">La Tormenta</Tag> (ATK+30/MAG+60/LUC+8) from it for <Tag type="char">Raynie</Tag>.</p>
      </BossCard>
      <Callout type="node" title="Historia Milestone: Turning of the Tide">
        <p>After the plot takes you out of the palace and waterway, you have to make your way to the Castle Gates. On your way there, you will encounter some Alistel Officers. Make sure to have Stocke steal two items from them, the last of which will be the <Tag type="weapon">Glaux Dagger</Tag> (ATK+31/MAG+85/HP-30, equip on <Tag type="char">Aht</Tag>). There are stationary Cannons on the map that have no items to steal. However, if you encounter a Cannon in a battle where you originally saw another enemy on the map, steal a <Tag type="weapon">Freikugel Zamiel</Tag> (ATK+18/MAG+75/DEF-12, equip on <Tag type="char">Eruca</Tag>) from them for a huge magic boost! Rest up at the inn, bring in Aht to replace Gafka, and continue east to run into an old friend.</p>
      </Callout>
      <BossCard name="Dias Guard x2, Gold, Sapphire" weakness="None, Ice, Fire">
        <p><strong>Strategy:</strong> Lay two <Tag type="skill">Ice Traps</Tag> behind Gold, and <Tag type="skill">Push Assault</Tag> him onto it. Take out the Dias Guards with <Tag type="skill">Burst Light</Tag> and any Star Trap. Then, steal twice from Sapphire to get the <Tag type="weapon">Beast Claw</Tag> (ATK+80/HP-50, equip on <Tag type="char">Gafka</Tag>). Finally, use a Fire Star Trap to finish off Sapphire.</p>
      </BossCard>
      <p>If <Tag type="char">Eruca</Tag> hasn&#x27;t reached Level 60 yet to learn her final spell, I&#x27;d recommend fighting some of the enemies below to do so. Afterwards, I would use <Tag type="char">Stocke</Tag>, <Tag type="char">Gafka</Tag>, and probably <Tag type="char">Rosch</Tag> could use the experience the most. Equip Rosch with the <Tag type="armor">Diamond Mail</Tag> from earlier. Head up to meet the final line of defense.</p>
      <BossCard name="Auto Defender x2, Viola" weakness="None, Poison">
        <p><strong>Strategy:</strong> This fight can be pretty hard without Gafka. <Tag type="char">Viola</Tag> uses Divine Protection, which negates the next 5 hits against her. Luckily, she is sitting right at the center of the battlefield. <Tag type="skill">Musou</Tag> will not only completely break down her Divine Protection, but also deal some good damage on its last hit. Use the <Tag type="skill">Change</Tag> command to string together five consecutive turns: two of Gafka and three of Stocke. Use two Musous on Viola and three <Tag type="skill">Will o&#x27; Wisps</Tag> to defeat them all quickly.</p>
      </BossCard>
      <Callout type="node" title="Historia Milestone: Viola's Last Stand">
        <p>After a brief respite, head up to the throne room and talk to <Tag type="char">Eruca</Tag>, where the scene will shift back to <Tag type="place">Alistel</Tag>.</p>
      </Callout>
      <Callout type="note" title="Recommended Equipment">
        <p>Recommended Equipment at this point in the game:<br/>
        <strong>Stocke:</strong> <Tag type="weapon">Pieti Edge</Tag>, <Tag type="armor">Moirae Manteau</Tag>, <Tag type="acc">Thauma Charm x3</Tag><br/>
        <strong>Raynie:</strong> <Tag type="weapon">La Tormenta</Tag>, <Tag type="armor">Diamond Mail</Tag>, <Tag type="acc">Thauma Charm x3</Tag><br/>
        <strong>Marco:</strong> <Tag type="weapon">Gaia Blade</Tag>, <Tag type="armor">Diamond Mail</Tag>, <Tag type="acc">Queen Stud x3</Tag><br/>
        <strong>Rosch:</strong> <Tag type="weapon">Death Pike</Tag>, <Tag type="armor">Diamond Mail</Tag>, <Tag type="acc">Beast Charm x3</Tag><br/>
        <strong>Aht:</strong> <Tag type="weapon">Glaux Dagger</Tag>, <Tag type="armor">Giant Cape</Tag>, <Tag type="acc">Queen Stud x3</Tag><br/>
        <strong>Gafka:</strong> <Tag type="weapon">Beast Claw</Tag>, <Tag type="armor">Mighty Protector</Tag>, <Tag type="acc">Beast Charm x3</Tag><br/>
        <strong>Eruca:</strong> <Tag type="weapon">Freikugel Zamiel</Tag>, <Tag type="armor">Skull Dress</Tag>, <Tag type="acc">Thauma Charm x3</Tag></p>
      </Callout>
    </div>
  </ChapterCard>

  <!-- Chapter 62 -->
  <ChapterCard
    id="ch62"
    number={62}
    title="Alistel (Alternate Chapter 6)"
    timeline="Alternate"
  >
    <TacticalBriefing
      level="63" party="Stocke, Aht, Rosch"
    />

    <div class="chapter-walkthrough-prose">
      <ShopMatrix title="Alistel (Alternate Chapter 6) Merchant" items={[{"name": "Soothing Balm", "price": 100}, {"name": "First Aid Kit", "price": 400}, {"name": "Tourniquet", "price": 1000}, {"name": "Herbal Tea", "price": 350}, {"name": "Special Tea", "price": 1200}, {"name": "Superior Tea", "price": 2500}, {"name": "Healing Herb", "price": 500}, {"name": "Holy Water", "price": 500}, {"name": "Anti-Poison", "price": 50}, {"name": "Anti-Fear", "price": 50}, {"name": "Anti-Paralytic", "price": 50}, {"name": "Anti-Curse", "price": 50}, {"name": "Anti-Sleep", "price": 50}, {"name": "Anti-Stone", "price": 50}, {"name": "Panacea", "price": 800}, {"name": "Panacea Plus", "price": 2000}, {"name": "Poison Wing", "price": 350}, {"name": "Sleep Wing", "price": 500}, {"name": "Power Down", "price": 500}, {"name": "Guard Down", "price": 500}, {"name": "Might Herb", "price": 500}, {"name": "Shield Herb", "price": 500}, {"name": "Divine Water", "price": 1500}]} equipment={[{"name": "Silver Edge", "price": 3000}, {"name": "Iron Sword", "price": 2400}, {"name": "Sorcery Epee", "price": 4600}, {"name": "Silver Spear", "price": 2000}, {"name": "Iron Lance", "price": 2100}, {"name": "Magic Spear", "price": 3200}, {"name": "Knife", "price": 1800}, {"name": "Death Shell", "price": 9500}, {"name": "Heavy Mail", "price": 1500}, {"name": "Silver Mail", "price": 1100}, {"name": "Silver Cape", "price": 2800}, {"name": "Reinforced Cape", "price": 1200}, {"name": "Gold Clothes", "price": 3200}, {"name": "Sunrise Cape", "price": 4800}, {"name": "Elemental Plate", "price": 8100}, {"name": "Apollo Dress", "price": 9300}, {"name": "Charm", "price": 350}, {"name": "Horn Charm", "price": 1000}, {"name": "Thauma Charm", "price": 5000}, {"name": "Pawn Stud", "price": 750}, {"name": "Knight Stud", "price": 1500}, {"name": "Breeze Armlet", "price": 1500}]} itemTitle="Item Shop" equipmentTitle="Equipment Shop" />
      <Callout type="node" title="Historia Milestone: In Pursuit">
        <p>Before heading to the <Tag type="place">Underground Lab</Tag>, talk to the receptionist at the castle to complete the [Swordsman Recruit] and [Mercenary Recruit] sidequests, receiving <Tag type="gold">8000 G</Tag> and <Tag type="gold">15000 G</Tag> for doing so. Go through the door on the right and talk to the old man in the hall to receive the [Thaumatech&#x27;s End] sidequest from him. When you&#x27;re ready, enter the left doorway and take the teleporter down to the Underground Lab.</p>
      </Callout>
    </div>
  </ChapterCard>

  <!-- Chapter 63 -->
  <ChapterCard
    id="ch63"
    number={63}
    title="Underground Lab (Alternate Chapter 6)"
    timeline="Alternate"
  >
    <TacticalBriefing
      level="63" party="Stocke, Aht, Rosch" enemies={[{"name": "Alistel Officer", "weakness": "spear, Sleep"}, {"name": "Alistel Officer", "weakness": "sword, None"}, {"name": "Heavy Thaumachine", "weakness": "Lightning"}, {"name": "Prod. Thautomaton", "weakness": "Lightning"}]}
    />

    <div class="chapter-walkthrough-prose">
      <AsciiMap>
<pre>B1          B2            B3          B4

          { name: "Seed Ring", price: 1000 },
          { name: "Breeze Armlet", price: 1500 }
        ]}
      />

      <AsciiMap title="Alistel Wards - Updated Access Routes">
<pre>   _____   _ ___
  | _|  | | |__ |  Second Ward
  |  _  |S|   _ |

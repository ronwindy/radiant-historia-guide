---

<BaseLayout title="Character Abilities & Skills" description="Complete ability learning lists, level requirements, MP costs, and sidequest scrolls for all 7 party members in Radiant Historia.">
  <div class="container abilities-container">
    <Breadcrumbs
      items={[
        { label: 'Compendium Hub', href: baseUrl },
        { label: 'Character Abilities & Skills' }
      ]}
    />

    <header class="page-header glass-card">
      <div class="header-badge">Combat Compendium</div>
      <h1 class="page-title">Character Abilities &amp; Skill Learning Lists</h1>
      <p class="page-subtitle">
        Comprehensive level-by-level skill progression, MP costs, grid effects, and pact skill sidequest scrolls for all seven playable characters.
      </p>

      <!-- Quick Character Jump Pills -->
      <div class="char-jump-pills">
        {characters.map((c) => (
          <a href={`#char-${c.name.toLowerCase()}`} class="char-pill" style={`border-left: 3px solid ${c.color}`}>
            <span>{c.name}</span>
          </a>
        ))}
      </div>
    </header>

    <!-- Character Skill Compendiums -->
    <div class="characters-list">
      {characters.map((c) => (
        <article id={`char-${c.name.toLowerCase()}`} class="glass-card char-card" style={`border-top: 4px solid ${c.color}`}>
          <div class="char-card-header">
            <div class="char-name-group">
              <h2 class="char-name">{c.name}</h2>
              <span class="char-role-badge">{c.role}</span>
            </div>
            <div class="char-weapon-tag">Weapon: {c.weapon}</div>
          </div>

          <p class="char-desc">{c.desc}</p>

          <h3 class="section-subtitle">Level-Up Skill Progression</h3>
          <div class="table-responsive">
            <table class="skills-table">
              <thead>
                <tr>
                  <th>Ability Name</th>
                  <th>Level</th>
                  <th>MP Cost</th>
                  <th>Tactical Effect &amp; Mechanics</th>
                </tr>
              </thead>
              <tbody>
                {c.skills.map((s) => (
                  <tr>
                    <td class="skill-name"><strong>{s.name}</strong></td>
                    <td class="skill-level">Lv. {s.level}</td>
                    <td class="skill-mp">{s.mp} MP</td>
                    <td class="skill-effect">{s.effect}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {c.scrollSkills && c.scrollSkills.length > 0 && (
            <div class="scroll-skills-block">
              <h4 class="scroll-skills-title">📜 Pact Skills (Sidequest Scrolls)</h4>
              <div class="scroll-grid">
                {c.scrollSkills.map((ss) => (
                  <div class="scroll-card">
                    <div class="scroll-header">
                      <strong>{ss.name}</strong>
                      <span class="scroll-quest">Quest: {ss.quest}</span>
                    </div>
                    <p class="scroll-desc">{ss.effect}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .abilities-container {
    padding-bottom: 4rem;
  }

  .page-header {
    border-top: 3px solid var(--gold-primary);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    margin-bottom: 2.5rem;
  }

  .header-badge {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--gold-primary);
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 850px;
    margin-bottom: 1.5rem;
  }

  .char-jump-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .char-pill {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-ui);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
  }

  .char-pill:hover {
    background: rgba(251, 191, 36, 0.12);
    color: var(--gold-primary);
    transform: translateY(-2px);
  }

  /* Character Cards */
  .char-card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    margin-bottom: 3rem;
  }

  .char-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.85rem;
    margin-bottom: 1rem;
  }

  .char-name-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    min-width: 0;
  }

  .char-name {
    font-size: 1.6rem;
    color: var(--text-bright);
    margin: 0;
    line-height: 1.25;
  }

  .char-role-badge {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .char-weapon-tag {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--gold-primary);
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .char-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .section-subtitle {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--gold-primary);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skills-table th {
    font-size: 0.82rem;
  }

  .skill-name {
    color: var(--text-bright);
  }

  .skill-level {
    color: var(--mana-cyan);
    font-family: var(--font-mono);
    font-weight: 600;
    white-space: nowrap;
  }

  .skill-mp {
    color: var(--gold-primary);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .skill-effect {
    color: var(--text-secondary);
  }

  /* Scroll Skills Block */
  .scroll-skills-block {
    margin-top: 1.5rem;
    background: rgba(6, 9, 15, 0.5);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .scroll-skills-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: #6ee7b7;
    margin-bottom: 0.85rem;
  }

  .scroll-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .scroll-card {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    font-family: var(--font-ui);
  }

  .scroll-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .scroll-header strong {
    color: var(--text-bright);
    font-size: 0.92rem;
  }

  .scroll-quest {
    font-size: 0.75rem;
    color: var(--mana-cyan);
    white-space: nowrap;
  }

  .scroll-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import nodesData from '../data/nodesData.json';
import chapterMapsData from '../data/chapterMaps.json';

const baseUrl = import.meta.env.BASE_URL;

// Group nodes by chapter
const chaptersOrder = [
  'PROLOGUE',
  'CHAPTER 1',
  'CHAPTER 2',
  'CHAPTER 3',
  'CHAPTER 4',
  'CHAPTER 5',
  'CHAPTER 6',
  'FINAL CHAPTER'
];

interface ChapterMapItem {
  subtitle: string;
  map: string;
}

const groupedNodes = chaptersOrder.map((chap) => {
  return {
    chapter: chap,
    maps: ((chapterMapsData as Record<string, ChapterMapItem[]>)[chap]) || [],
    nodes: nodesData.filter((n) => n.chapter === chap)
  };
});

function formatMapHtml(mapText: string) {
  const escaped = mapText
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  
  return escaped.replace(/\b(\d{3})\b/g, '<a href="#node-$1" class="map-node-pill" data-node="$1" title="Jump to Node #$1">$1</a>');
}
---

<BaseLayout title="236 Historia Node Completion List & Sidequests" description="Complete 100% checklist for all 236 White Chronicle nodes, sidequests, and bad endings in Radiant Historia with client-side progress tracking and ASCII timeline flowcharts.">
  <div class="container nodes-page-container">
    <Breadcrumbs
      items={[
        { label: 'Compendium Hub', href: baseUrl },
        { label: '236 Historia Node Tracker' }
      ]}
    />

    <header class="page-header glass-card">
      <div class="header-badge">The White Chronicle Matrix</div>
      <h1 class="page-title">236 Historia Node Completion &amp; Sidequest Hub</h1>
      <p class="page-subtitle">
        Filter, search, and track all 236 White Chronicle timeline milestones, bad ending branches (Possible Histories), and cross-timeline sidequest solutions.
      </p>

      <!-- Live Node Progress Widget -->
      <div class="node-progress-strip">
        <div class="progress-info">
          <span class="progress-lbl">White Chronicle Unlocked:</span>
          <span class="progress-count"><strong id="nodeLiveCount">0</strong> / 236</span>
        </div>
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" id="nodeLiveBar" style="width: 0%;"></div>
        </div>
      </div>
    </header>

    <!-- Filter & Search Controls -->
    <div class="filter-controls glass-card">
      <div class="search-bar-wrap">
        <span class="search-icon">🔍</span>
        <input type="text" id="nodeSearchInput" class="node-search-input" placeholder="Search node # (e.g. 010), title (e.g. Night Watch), or keyword..." />
      </div>

      <div class="filter-groups-wrap">
        <div class="filter-group">
          <span class="filter-lbl">Timeline:</span>
          <div class="filter-pills" id="timelineFilters">
            <button type="button" class="filter-pill active" data-filter="all">All</button>
            <button type="button" class="filter-pill" data-filter="Standard">Standard</button>
            <button type="button" class="filter-pill" data-filter="Alternate">Alternate</button>
            <button type="button" class="filter-pill" data-filter="Prologue">Prologue</button>
            <button type="button" class="filter-pill" data-filter="Final">Final</button>
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-lbl">Type:</span>
          <div class="filter-pills" id="typeFilters">
            <button type="button" class="filter-pill active" data-type="all">All</button>
            <button type="button" class="filter-pill" data-type="Plot">Main Plot</button>
            <button type="button" class="filter-pill" data-type="Sidequest">Sidequests</button>
            <button type="button" class="filter-pill" data-type="Bad Ending">Bad Endings</button>
            <button type="button" class="filter-pill" data-type="Ending">Grand Endings</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Grouped Nodes Listing -->
    <div class="nodes-listing" id="nodesListing">
      {groupedNodes.map((group) => (
        <section class="chapter-node-group" data-chapter={group.chapter}>
          <div class="chapter-node-header">
            <h2 class="chapter-node-title">{group.chapter}</h2>
            <span class="chapter-node-count">{group.nodes.length} Nodes</span>
          </div>

          {group.maps && group.maps.length > 0 && (
            <div class="chapter-maps-container">
              {group.maps.map((mapItem) => (
                <div class="chapter-map-card glass-card">
                  <div class="chapter-map-header">
                    <div class="chapter-map-title-row">
                      <span class="chapter-map-badge">⏳ Timeline Matrix</span>
                      <span class="chapter-map-subtitle">{mapItem.subtitle}</span>
                    </div>
                    <span class="chapter-map-hint">💡 Click any node # to jump to its entry</span>
                  </div>
                  <div class="chapter-map-viewport">
                    <pre class="ascii-map-code" set:html={formatMapHtml(mapItem.map)} />
                  </div>
                </div>
              ))}
            </div>
          )}

          <div class="nodes-grid">
            {group.nodes.map((n) => (
              <article
                class={`node-card glass-card node-type-${n.type.toLowerCase().replace(' ', '-')}`}
                id={`node-${n.num}`}
                data-node-num={n.num}
                data-timeline={n.timeline}
                data-type={n.type}
              >
                <div class="node-card-header">
                  <div class="node-num-pill">#{n.num}</div>
                  <h3 class="node-title">{n.title}</h3>
                  <label class="node-check-label" title="Mark node as unlocked">
                    <input type="checkbox" class="node-checkbox" data-node-num={n.num} />
                    <span class="node-checkbox-custom"></span>
                  </label>
                </div>

                <div class="node-badges-row">
                  {n.type === 'Bad Ending' && (
                    <span class="badge badge-alternate">⚠️ Possible History</span>
                  )}
                  {n.type === 'Sidequest' && (
                    <span class="badge badge-green">📜 Sidequest</span>
                  )}
                  {n.type === 'Plot' && (
                    <span class="badge badge-cyan">✨ Main Plot</span>
                  )}
                  {n.type === 'Ending' && (
                    <span class="badge badge-gold">👑 Grand Ending</span>
                  )}
                  <span class="node-timeline-tag">{n.timeline}</span>
                </div>

                <div class="node-req-content">
                  <p>{n.requirement}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>

    opacity: 0;
    width: 0;
    height: 0;
  }

  .node-checkbox-custom {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 2px solid var(--text-muted);
    border-radius: 4px;
    position: relative;
    transition: var(--transition);
  }

  .node-checkbox:checked ~ .node-checkbox-custom {
    background: var(--mana-green);
    border-color: var(--mana-green);
  }

  .node-checkbox:checked ~ .node-checkbox-custom::after {
    content: '';

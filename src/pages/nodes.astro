    border-left-color: var(--mana-cyan);
  }

  .node-type-ending {
    border-left-color: var(--gold-primary);
  }

  .node-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .node-num-pill {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--mana-cyan);
    background: rgba(6, 182, 212, 0.12);
    border: 1px solid rgba(6, 182, 212, 0.3);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .node-title {
    font-size: 1.1rem;
    color: var(--text-bright);
    margin: 0;
    flex-grow: 1;
    line-height: 1.3;

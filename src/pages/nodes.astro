    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
  }

  .node-req-content {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 0.25rem;
    white-space: pre-line;
  }

  .node-req-content p {
    margin: 0;
  }

  .node-card.hidden {
    display: none !important;
  }

  .chapter-node-group.hidden {
    display: none !important;
  }
</style>

<script>
  if (typeof document !== 'undefined') {
    // 1. Synchronize ASCII map pills with completed nodes
    function syncMapPills(completedList: string[]) {
      const pills = document.querySelectorAll<HTMLElement>('.map-node-pill');
      pills.forEach((pill) => {
        const num = pill.getAttribute('data-node');
        if (num && completedList.includes(num)) {
          pill.classList.add('node-pill-completed');
        } else {
          pill.classList.remove('node-pill-completed');
        }
      });
    }

    // 2. Checkboxes & localStorage synchronization
    function setupNodeCheckboxes() {
      try {
        const stored = localStorage.getItem('rh-guide-completed-nodes');
        const completed: string[] = stored ? JSON.parse(stored) : [];

        const checkboxes = document.querySelectorAll<HTMLInputElement>('.node-checkbox');
        checkboxes.forEach((cb) => {
          const num = cb.getAttribute('data-node-num');
          if (num && completed.includes(num)) {
            cb.checked = true;
            cb.closest('.node-card')?.classList.add('completed');
          } else {
            cb.checked = false;
            cb.closest('.node-card')?.classList.remove('completed');
          }

          cb.addEventListener('change', () => {
            try {
              const curStored = localStorage.getItem('rh-guide-completed-nodes');
              let curList: string[] = curStored ? JSON.parse(curStored) : [];
              if (cb.checked) {
                if (num && !curList.includes(num)) curList.push(num);
                cb.closest('.node-card')?.classList.add('completed');
              } else {
                curList = curList.filter(n => n !== num);
                cb.closest('.node-card')?.classList.remove('completed');
              }
              localStorage.setItem('rh-guide-completed-nodes', JSON.stringify(curList));
              updateNodeCountDisplay(curList.length);
              syncMapPills(curList);
              window.dispatchEvent(new Event('rh-progress-updated'));
            } catch (err) {
              console.error('Failed to update node in localStorage', err);
            }
          });
        });

        updateNodeCountDisplay(completed.length);
        syncMapPills(completed);
      } catch (err) {
        console.error('Failed to init node checkboxes', err);
      }
    }

    function updateNodeCountDisplay(count: number) {
      const countElem = document.getElementById('nodeLiveCount');
      const barElem = document.getElementById('nodeLiveBar');
      if (countElem) countElem.textContent = String(count);
      if (barElem) {
        const pct = Math.round((count / 236) * 100);
        barElem.style.width = `${pct}%`;
      }
    }

    setupNodeCheckboxes();

    // 3. Interactive Filtering & Search
    let activeTimeline = 'all';
    let activeType = 'all';
    let searchQuery = '';

    const timelineBtns = document.querySelectorAll<HTMLButtonElement>('#timelineFilters .filter-pill');
    const typeBtns = document.querySelectorAll<HTMLButtonElement>('#typeFilters .filter-pill');
    const searchInput = document.getElementById('nodeSearchInput') as HTMLInputElement;

    function applyFilters() {
      const nodeCards = document.querySelectorAll<HTMLElement>('.node-card');
      const groups = document.querySelectorAll<HTMLElement>('.chapter-node-group');

      nodeCards.forEach((card) => {
        const tl = card.getAttribute('data-timeline') || '';
        const tp = card.getAttribute('data-type') || '';
        const num = card.getAttribute('data-node-num') || '';
        const title = card.querySelector('.node-title')?.textContent?.toLowerCase() || '';
        const req = card.querySelector('.node-req-content')?.textContent?.toLowerCase() || '';

        let matchesTl = (activeTimeline === 'all') || (tl.toLowerCase() === activeTimeline.toLowerCase());
        let matchesTp = (activeType === 'all') || (tp.toLowerCase() === activeType.toLowerCase());
        
        let matchesSearch = true;
        if (searchQuery.trim() !== '') {
          const q = searchQuery.toLowerCase();
          matchesSearch = num.includes(q) || title.includes(q) || req.includes(q);
        }

        if (matchesTl && matchesTp && matchesSearch) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });

      // Hide empty chapter groups
      groups.forEach((grp) => {
        const visibleCards = grp.querySelectorAll('.node-card:not(.hidden)');
        if (visibleCards.length === 0) {
          grp.classList.add('hidden');
        } else {
          grp.classList.remove('hidden');
        }
      });
    }

    timelineBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        timelineBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeTimeline = btn.getAttribute('data-filter') || 'all';
        applyFilters();
      });
    });

    typeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        typeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeType = btn.getAttribute('data-type') || 'all';
        applyFilters();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    // 4. Map pill click handling to jump & pulse highlight card
    document.querySelectorAll<HTMLAnchorElement>('.map-node-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const num = pill.getAttribute('data-node');
        if (!num) return;
        const target = document.getElementById(`node-${num}`);
        if (target) {
          if (target.classList.contains('hidden')) {
            activeTimeline = 'all';
            activeType = 'all';
            searchQuery = '';
            if (searchInput) searchInput.value = '';
            timelineBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-filter') === 'all'));
            typeBtns.forEach((b) => b.classList.toggle('active', b.getAttribute('data-type') === 'all'));
            applyFilters();
          }
          target.classList.remove('highlight-pulse');
          void target.offsetWidth;
          target.classList.add('highlight-pulse');
        }
      });
    });
  }
</script>

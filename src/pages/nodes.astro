  }

  :global(.map-node-pill) {
    display: inline-block;
    padding: 0.08rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--mana-cyan, #00e5ff);
    background: rgba(0, 229, 255, 0.12);
    border: 1px solid rgba(0, 229, 255, 0.35);
    border-radius: 4px;

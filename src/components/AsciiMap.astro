---
interface Props {
  title?: string;
  mapText?: string;
}

const { title = 'Tactical Area Map & Chest Coordinates', mapText } = Astro.props;
---

<div class="ascii-map-container">
  <div class="map-header">
    <span class="map-icon">🗺️</span>
    <span class="map-title">{title}</span>
  </div>

  <div class="map-viewport">
    {mapText ? (
      <pre class="ascii-content">{mapText}</pre>
    ) : (
      <div class="ascii-content-wrapper">
        <slot />
      </div>
    )}
  </div>
</div>

<style>
  .ascii-map-container {
    background: #05080f;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
    overflow: hidden;
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .map-header {
    background: rgba(19, 28, 45, 0.9);
    padding: 0.6rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--mana-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid rgba(6, 182, 212, 0.2);
  }

  .map-viewport {
    padding: 1rem;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .ascii-content,
  .ascii-content-wrapper :global(pre) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.35;
    color: #93c5fd;
    white-space: pre;
    min-width: max-content;
    margin: 0;
  }
</style>

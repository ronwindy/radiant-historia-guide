---
interface EnemyInfo {
  name: string;
  weakness?: string | null;
}

interface Props {
  level?: number | string | null;
  party?: string | null;
  enemies?: EnemyInfo[] | string | null;
  inn?: string | number | null;
}

const { level, party, enemies, inn } = Astro.props;

function getElemClass(weakness?: string | null) {
  if (!weakness) return '';
  const w = weakness.toLowerCase();
  if (w.includes('fire')) return 'elem-fire';
  if (w.includes('ice') || w.includes('frost')) return 'elem-ice';
  if (w.includes('thunder') || w.includes('lightn')) return 'elem-thunder';
  if (w.includes('poison')) return 'elem-poison';
  if (w.includes('holy')) return 'elem-holy';
  if (w.includes('phys')) return 'elem-physical';
  return 'elem-ice';
}
---

<div class="tactical-briefing">
  <div class="briefing-header">
    <span class="briefing-icon">⚔️</span>
    <span class="briefing-title">Tactical Briefing &amp; Intel</span>
  </div>

  <div class="briefing-grid">
    {level && (
      <div class="briefing-item">
        <span class="item-label">Recommended Level:</span>
        <span class="item-value level-value">Lv. {level}</span>
      </div>
    )}

    {party && (
      <div class="briefing-item">
        <span class="item-label">Recommended Party:</span>
        <span class="item-value party-value">{party}</span>
      </div>
    )}

    {inn && (
      <div class="briefing-item">
        <span class="item-label">Inn Lodging:</span>
        <span class="item-value inn-value">{inn}</span>
      </div>
    )}
  </div>

  {enemies && (
    <div class="enemies-section">
      <span class="enemies-label">Encounter Intel &amp; Weaknesses:</span>
      <div class="enemies-list">
        {typeof enemies === 'string' ? (
          <span class="enemies-text">{enemies}</span>
        ) : (
          enemies.map((e) => (
            <div class="enemy-pill">
              <span class="enemy-name">{e.name}</span>
              {e.weakness && (
                <span class={`elem-pill ${getElemClass(e.weakness)}`}>
                  {e.weakness}
                </span>
              )}
            </div>
          ))
        )}
      </div>
    </div>
  )}

  <slot />
</div>

<style>
  .tactical-briefing {
    background: rgba(19, 28, 45, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin: 1.25rem 0 1.75rem 0;
    font-family: var(--font-ui);
    font-size: 0.92rem;
  }

  .briefing-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    color: var(--gold-primary);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    line-height: 1.3;
    margin-bottom: 0.85rem;
    border-bottom: 1px solid rgba(251, 191, 36, 0.15);
    padding-bottom: 0.4rem;
  }

  .briefing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem 1.25rem;
  }

  .briefing-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item-label {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .item-value {
    color: var(--text-primary);
    font-weight: 600;
  }

  .level-value {
    color: var(--mana-cyan);
    font-family: var(--font-mono);
  }

  .party-value {
    color: var(--gold-primary);
  }

  .inn-value {
    color: var(--mana-teal);
  }

  .enemies-section {
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(148, 163, 184, 0.1);
  }

  .enemies-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .enemies-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .enemy-pill {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border-subtle);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .enemy-name {
    color: var(--text-primary);
  }

  .enemies-text {
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>

---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="header-container">
    <div class="brand-group">
      <a href={baseUrl} class="logo-link" aria-label="Radiant Historia Compendium Home">
        <img src={`${baseUrl}assets/logo.png`} alt="Radiant Historia Logo" class="brand-logo" width="160" height="48" />
        <span class="brand-subtitle">The White Chronicle Compendium</span>
      </a>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <a href={baseUrl} class={`nav-link ${currentPath === '/' || currentPath === '' ? 'active' : ''}`}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span>Hub</span>
      </a>

      <a href={`${baseUrl}introduction/`} class={`nav-link ${currentPath.includes('introduction') ? 'active' : ''}`}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/>
          <line x1="13" y1="19" x2="19" y2="13"/>
          <line x1="16" y1="16" x2="20" y2="20"/>
          <line x1="19" y1="21" x2="21" y2="19"/>
          <polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/>
          <line x1="5" y1="14" x2="9" y2="18"/>
          <line x1="7" y1="17" x2="4" y2="20"/>
          <line x1="3" y1="19" x2="5" y2="21"/>
        </svg>
        <span>Systems &amp; Tactics</span>
      </a>
      
      <div class="nav-dropdown">
        <button class={`nav-link dropdown-toggle ${currentPath.includes('walkthrough') ? 'active' : ''}`} aria-haspopup="true" aria-expanded="false">
          <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-0-5H20"/>
            <path d="M6 6h10"/>
            <path d="M6 10h10"/>
          </svg>
          <span>Walkthrough</span>
          <svg class="dropdown-chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="dropdown-menu">
          <div class="dropdown-menu-header">Chronicle Walkthroughs</div>
          <a href={`${baseUrl}walkthrough/volume-1/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-prologue">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol I: Prologue &amp; Ch. 1</span>
              <span class="dropdown-item-meta">Chapters 01–10 &bull; Lazvil Hills</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-2/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-standard">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol II: Specint &amp; Resistance</span>
              <span class="dropdown-item-meta">Chapters 11–20 &bull; Gran Plain</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-3/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol III: Celestia &amp; Fortresses</span>
              <span class="dropdown-item-meta">Chapters 21–30 &bull; Rosch Brigade</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-4/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-standard">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol IV: Sand Fortress &amp; Cygnus</span>
              <span class="dropdown-item-meta">Chapters 31–40 &bull; Desert City</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-5/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M4 10l8-7 8 7"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol V: Holff Ruins &amp; Forgia</span>
              <span class="dropdown-item-meta">Chapters 41–50 &bull; Beastkind Pact</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-6/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 2v7.31L4.62 17.5A2 2 0 0 0 6.34 20h11.32a2 2 0 0 0 1.72-2.5L14 9.31V2"/>
                <line x1="8.5" y1="2" x2="15.5" y2="2"/>
                <line x1="7" y1="15" x2="17" y2="15"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol VI: Beastkind &amp; Lab</span>
              <span class="dropdown-item-meta">Chapters 51–60 &bull; Thaumatech Core</span>
            </div>
          </a>
          <a href={`${baseUrl}walkthrough/volume-7/`} class="dropdown-item">
            <span class="dropdown-item-icon vol-final">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"/>
                <path d="M5 20h14"/>
              </svg>
            </span>
            <div class="dropdown-item-text">
              <span class="dropdown-item-title">Vol VII: Final Chapters</span>
              <span class="dropdown-item-meta">Chapters 61–66 &bull; Convergent Climax</span>
            </div>
          </a>
        </div>
      </div>

      <a href={`${baseUrl}nodes/`} class={`nav-link ${currentPath.includes('nodes') ? 'active' : ''}`}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="6" cy="6" r="3"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="12" r="3"/>
          <line x1="6" y1="9" x2="6" y2="15"/>
          <path d="M8.5 7.5L15.5 10.5"/>
          <path d="M8.5 16.5L15.5 13.5"/>
        </svg>
        <span>236 Nodes</span>
      </a>

      <a href={`${baseUrl}abilities/`} class={`nav-link ${currentPath.includes('abilities') ? 'active' : ''}`}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
        </svg>
        <span>Abilities</span>
      </a>

      <a href={`${baseUrl}credits/`} class={`nav-link ${currentPath.includes('credits') ? 'active' : ''}`}>
        <svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
          <polyline points="10 9 9 9 8 9"/>
        </svg>
        <span>Credits</span>
      </a>
    </nav>

    <!-- Progress Badge & Mobile Toggle -->
    <div class="header-actions">
      <div class="nav-progress-badge" id="globalProgressBadge" title="Walkthrough Chapters Completed">
        <span class="progress-icon">📜</span>
        <span class="progress-text"><strong id="headerCompletedCount">0</strong> / 66</span>
      </div>

      <button class="mobile-toggle-btn" id="mobileMenuToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
    <div class="mobile-drawer-content">
      <div class="drawer-header">
        <span class="drawer-title">Navigation Matrix</span>
        <button class="drawer-close-btn" id="drawerCloseBtn" aria-label="Close menu">&times;</button>
      </div>

      <nav class="mobile-nav">
        <a href={baseUrl} class="mobile-nav-link">
          <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <span>Compendium Hub</span>
        </a>
        <a href={`${baseUrl}introduction/`} class="mobile-nav-link">
          <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" y1="19" x2="19" y2="13"/><line x1="16" y1="16" x2="20" y2="20"/><line x1="19" y1="21" x2="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" y1="14" x2="9" y2="18"/>
          <line x1="7" y1="17" x2="4" y2="20"/><line x1="3" y1="19" x2="5" y2="21"/></svg>
          <span>Systems &amp; Battle Tactics</span>
        </a>
        
        <div class="mobile-section-title">Walkthrough Volumes</div>
        <div class="mobile-vol-list">
          <a href={`${baseUrl}walkthrough/volume-1/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-prologue">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span>Vol I: Chapters 01–10</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-2/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-standard">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <span>Vol II: Chapters 11–20</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-3/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </span>
            <span>Vol III: Chapters 21–30</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-4/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-standard">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
            </span>
            <span>Vol IV: Chapters 31–40</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-5/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M4 10l8-7 8 7"/></svg>
            </span>
            <span>Vol V: Chapters 41–50</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-6/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-alternate">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2v7.31L4.62 17.5A2 2 0 0 0 6.34 20h11.32a2 2 0 0 0 1.72-2.5L14 9.31V2"/><line x1="8.5" y1="2" x2="15.5" y2="2"/><line x1="7" y1="15" x2="17" y2="15"/></svg>
            </span>
            <span>Vol VI: Chapters 51–60</span>
          </a>
          <a href={`${baseUrl}walkthrough/volume-7/`} class="mobile-sublink">
            <span class="dropdown-item-icon vol-final">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"/><path d="M5 20h14"/></svg>
            </span>
            <span>Vol VII: Chapters 61–66</span>
          </a>
        </div>

        <a href={`${baseUrl}nodes/`} class="mobile-nav-link">
          <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="12" r="3"/><line x1="6" y1="9" x2="6" y2="15"/><path d="M8.5 7.5L15.5 10.5"/><path d="M8.5 16.5L15.5 13.5"/></svg>
          <span>236 Nodes &amp; Quests</span>
        </a>
        <a href={`${baseUrl}abilities/`} class="mobile-nav-link">
          <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span>Ability Learning List</span>
        </a>
        <a href={`${baseUrl}credits/`} class="mobile-nav-link">
          <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>Credits &amp; Info</span>
        </a>
      </nav>
    </div>
  </div>
  <div class="sidebar-overlay" id="mobileOverlay"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(6, 9, 15, 0.94);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    font-family: var(--font-ui);
  }

  .header-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0.6rem clamp(1rem, 2.5vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .brand-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .logo-link {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-decoration: none;
  }

  .brand-logo {
    height: 38px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgba(251, 191, 36, 0.35));
  }

  .brand-subtitle {
    font-size: 0.68rem;
    font-family: var(--font-heading);
    letter-spacing: 0.12em;
    color: var(--gold-muted);
    text-transform: uppercase;
    margin-top: -2px;
  }

  /* Desktop Nav */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 0.45rem 0.75rem;
    border-radius: var(--radius-md);
    transition: var(--transition);
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-icon {
    flex-shrink: 0;
    opacity: 0.8;
    transition: transform 0.2s ease, opacity 0.2s ease, filter 0.2s ease;
  }

  .nav-link:hover .nav-icon,
  .nav-link.active .nav-icon {
    opacity: 1;
    color: var(--gold-primary);
    filter: drop-shadow(0 0 5px rgba(251, 191, 36, 0.5));
  }

  .nav-link:hover, .nav-link.active {
    color: var(--gold-primary);
    background: rgba(251, 191, 36, 0.08);
  }

  /* Dropdown */
  .nav-dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }

  .dropdown-chevron {
    flex-shrink: 0;
    margin-left: 0.1rem;
    opacity: 0.7;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease;
  }

  .nav-dropdown:hover .dropdown-chevron,
  .nav-dropdown:focus-within .dropdown-chevron {
    transform: rotate(180deg);
    opacity: 1;
    color: var(--gold-primary);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    background: rgba(10, 15, 26, 0.98);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--gold-border);
    border-radius: var(--radius-md);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.85), 0 0 20px rgba(251, 191, 36, 0.12);
    min-width: 320px;
    padding: 0.4rem;
    display: none;
    z-index: 1010;
  }

  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown:focus-within .dropdown-menu {
    display: block;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .dropdown-menu-header {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-muted);
    padding: 0.35rem 0.65rem 0.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 0.25rem;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.65rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: var(--transition);
    border-radius: var(--radius-sm);
    border-left: 2px solid transparent;
  }

  .dropdown-item:hover {
    background: rgba(251, 191, 36, 0.08);
    border-left-color: var(--gold-primary);
    transform: translateX(2px);
  }

  .dropdown-item-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: var(--transition);
  }

  .dropdown-item:hover .dropdown-item-icon {
    transform: scale(1.08);
  }

  .vol-prologue {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.35);
  }

  .vol-standard {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.35);
  }

  .vol-alternate {
    background: rgba(244, 63, 94, 0.15);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.35);
  }

  .vol-final {
    background: rgba(234, 179, 8, 0.15);
    color: #fde047;
    border: 1px solid rgba(234, 179, 8, 0.35);
  }

  .dropdown-item-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .dropdown-item-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  .dropdown-item:hover .dropdown-item-title {
    color: var(--gold-primary);
  }

  .dropdown-item-meta {

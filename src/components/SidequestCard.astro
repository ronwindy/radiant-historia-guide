---
interface Props {
  title: string;
  nodeNumber?: string | number;
  triggerNode?: string;
  location?: string;
  rewards?: string;
}

const { title, nodeNumber, triggerNode, location, rewards } = Astro.props;
---

<div class="sidequest-card">
  <div class="sidequest-header">
    <div class="sidequest-title-wrap">
      <span class="sidequest-icon">📜</span>
      <h3 class="sidequest-title">{title}</h3>
      {nodeNumber && <span class="node-pill">Node #{nodeNumber}</span>}
    </div>
    <span class="sidequest-badge">Sidequest Log</span>
  </div>

  <div class="sidequest-meta-grid">
    {triggerNode && (
      <div class="meta-cell">
        <span class="meta-label">Initiation Node:</span>
        <span class="meta-val">{triggerNode}</span>
      </div>
    )}
    {location && (
      <div class="meta-cell">
        <span class="meta-label">Client Location:</span>
        <span class="meta-val">{location}</span>
      </div>
    )}
    {rewards && (
      <div class="meta-cell">
        <span class="meta-label">Quest Rewards:</span>
        <span class="meta-val reward-val">{rewards}</span>
      </div>
    )}
  </div>

  <div class="sidequest-content">
    <slot />
  </div>
</div>

<style>
  .sidequest-card {
    background: rgba(16, 185, 129, 0.05);
    border: 1px solid rgba(16, 185, 129, 0.35);
    border-radius: var(--radius-md);
    padding: 1.2rem 1.4rem;
    margin: 1.5rem 0;
  }

  .sidequest-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(16, 185, 129, 0.2);
    padding-bottom: 0.6rem;
    margin-bottom: 0.85rem;
  }

  .sidequest-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .sidequest-icon {
    font-size: 1.2rem;
  }

  .sidequest-title {
    font-size: 1.15rem;
    color: #6ee7b7;
    margin: 0;
  }

  .node-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: rgba(0, 0, 0, 0.4);
    color: var(--mana-cyan);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(6, 182, 212, 0.3);
  }

  .sidequest-badge {
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.4);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
  }

  .sidequest-meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.6rem;
    background: rgba(6, 9, 15, 0.5);
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 0.85rem;
    font-family: var(--font-ui);
    font-size: 0.85rem;
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .meta-label {
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    font-weight: 600;
  }

  .meta-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .reward-val {
    color: var(--gold-primary);
  }

  .sidequest-content {
    color: var(--text-primary);
    font-size: 1.05rem;
    line-height: 1.65;
  }
</style>

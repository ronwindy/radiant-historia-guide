---
interface Props {
  showNodes?: boolean;
}

const { showNodes = true } = Astro.props;
---

<div class="progress-dashboard glass-card" id="progressDashboard">
  <div class="dashboard-header">
    <div class="dashboard-title-group">
      <span class="dashboard-icon">📊</span>
      <h3 class="dashboard-title">White Chronicle Progression Status</h3>
    </div>
    <span class="storage-tag">Browser Local Storage</span>
  </div>

  <div class="progress-stats-grid">
    <!-- Chapter Progress -->
    <div class="stat-card">
      <div class="stat-card-header">
        <span class="stat-name">Walkthrough Chapters</span>
        <span class="stat-fraction"><strong id="chaptersDoneText">0</strong> / 66</span>
      </div>
      <div class="progress-bar-track">
        <div class="progress-bar-fill chapters-fill" id="chaptersProgressBar" style="width: 0%;"></div>
      </div>
      <div class="stat-percentage" id="chaptersPercentText">0% Completed</div>
    </div>

    <!-- Node Progress -->
    {showNodes && (
      <div class="stat-card">
        <div class="stat-card-header">
          <span class="stat-name">Historia Nodes</span>
          <span class="stat-fraction"><strong id="nodesDoneText">0</strong> / 236</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill nodes-fill" id="nodesProgressBar" style="width: 0%;"></div>
        </div>
        <div class="stat-percentage" id="nodesPercentText">0% Unlocked</div>
      </div>
    )}
  </div>
</div>

<style>
  .progress-dashboard {
    padding: 1.5rem;
    margin: 2rem 0;
  }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .dashboard-title-group {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .dashboard-icon {
    font-size: 1.3rem;
  }

  .dashboard-title {
    font-size: 1.15rem;
    color: var(--gold-primary);
    margin: 0;
  }

  .storage-tag {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .progress-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .stat-card {
    background: rgba(6, 9, 15, 0.5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-ui);
  }

  .stat-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.88rem;
  }

  .stat-name {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .stat-fraction {
    color: var(--text-bright);
    font-family: var(--font-mono);
  }

  .stat-fraction strong {
    color: var(--gold-primary);
  }

  .progress-bar-track {
    width: 100%;
    height: 10px;
    background: #0f172a;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .progress-bar-fill {
    height: 100%;
    transition: width 0.4s ease;
    border-radius: var(--radius-full);
  }

  .chapters-fill {
    background: linear-gradient(90deg, #3b82f6, #f59e0b);
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
  }

  .nodes-fill {
    background: linear-gradient(90deg, #06b6d4, #10b981);
    box-shadow: 0 0 10px rgba(6, 182, 212, 0.5);
  }

  .stat-percentage {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-align: right;
    font-weight: 600;
  }
</style>

<script>
  if (typeof document !== 'undefined') {
    function updateDashboard() {
      try {
        // Chapters
        const chapStored = localStorage.getItem('rh-guide-completed-chapters');
        const chapList = chapStored ? JSON.parse(chapStored) : [];
        const chapCount = chapList.length;
        const chapPct = Math.round((chapCount / 66) * 100);

        const chDone = document.getElementById('chaptersDoneText');
        const chBar = document.getElementById('chaptersProgressBar');
        const chPct = document.getElementById('chaptersPercentText');

        if (chDone) chDone.textContent = String(chapCount);
        if (chBar) chBar.style.width = `${chapPct}%`;
        if (chPct) chPct.textContent = `${chapPct}% Completed`;

        // Nodes
        const nodeStored = localStorage.getItem('rh-guide-completed-nodes');
        const nodeList = nodeStored ? JSON.parse(nodeStored) : [];
        const nodeCount = nodeList.length;
        const nodePct = Math.round((nodeCount / 236) * 100);

        const nodeDone = document.getElementById('nodesDoneText');
        const nodeBar = document.getElementById('nodesProgressBar');
        const nodePctText = document.getElementById('nodesPercentText');

        if (nodeDone) nodeDone.textContent = String(nodeCount);
        if (nodeBar) nodeBar.style.width = `${nodePct}%`;
        if (nodePctText) nodePctText.textContent = `${nodePct}% Unlocked`;
      } catch (err) {
        console.error('Failed to sync progress dashboard', err);
      }
    }

    updateDashboard();
    window.addEventListener('storage', updateDashboard);
    window.addEventListener('rh-progress-updated', updateDashboard);
  }
</script>

---
interface Props {
  showNodes?: boolean;
}

const { showNodes = true } = Astro.props;
---

<div class="progress-dashboard glass-card" id="progressDashboard">
  <div class="dashboard-top-row">
    <div class="dashboard-title-group">
      <span class="dashboard-icon">📊</span>
      <h3 class="dashboard-title">Current Progress</h3>
    </div>
  </div>

  <div class="progress-stats-row">
    <!-- Chapter Progress -->
    <div class="stat-compact-item">
      <div class="stat-compact-meta">
        <span class="stat-name">Chapters</span>
        <span class="stat-fraction"><strong id="chaptersDoneText">0</strong>/66</span>
      </div>
      <div class="progress-bar-track">
        <div class="progress-bar-fill chapters-fill" id="chaptersProgressBar" style="width: 0%;"></div>
      </div>
      <span class="stat-percentage" id="chaptersPercentText">0%</span>
    </div>

    <!-- Node Progress -->
    {showNodes && (
      <div class="stat-compact-item">
        <div class="stat-compact-meta">
          <span class="stat-name">Historia Nodes</span>
          <span class="stat-fraction"><strong id="nodesDoneText">0</strong>/236</span>
        </div>
        <div class="progress-bar-track">
          <div class="progress-bar-fill nodes-fill" id="nodesProgressBar" style="width: 0%;"></div>
        </div>
        <span class="stat-percentage" id="nodesPercentText">0%</span>
      </div>
    )}
  </div>
</div>

<style>
  .progress-dashboard {
    padding: 0.85rem 1.25rem;
    margin: 0.35rem 0 2rem 0;
    background: rgba(15, 23, 42, 0.65);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .dashboard-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .dashboard-title-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .dashboard-icon {
    font-size: 1.05rem;
  }

  .dashboard-title {
    font-size: 0.92rem;
    font-family: var(--font-ui);
    font-weight: 700;
    color: var(--gold-primary);
    margin: 0;
    letter-spacing: 0.02em;
  }

  .progress-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.85rem 1.5rem;
    align-items: center;
  }

  .stat-compact-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-ui);
  }

  .stat-compact-meta {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    font-size: 0.82rem;
    min-width: 115px;
  }

  .stat-name {
    color: var(--text-secondary);
    font-weight: 600;
  }

  .stat-fraction {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .stat-fraction strong {
    color: var(--gold-primary);
  }

  .progress-bar-track {
    flex-grow: 1;
    height: 7px;
    background: #0f172a;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.15);
    min-width: 60px;
  }

  .progress-bar-fill {
    height: 100%;
    transition: width 0.4s ease;
    border-radius: var(--radius-full);
  }

  .chapters-fill {
    background: linear-gradient(90deg, #3b82f6, #f59e0b);
    box-shadow: 0 0 8px rgba(245, 158, 11, 0.4);
  }

  .nodes-fill {
    background: linear-gradient(90deg, #06b6d4, #10b981);
    box-shadow: 0 0 8px rgba(6, 182, 212, 0.4);
  }

  .stat-percentage {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
    font-family: var(--font-mono);
    min-width: 36px;
    text-align: right;
  }
</style>

<script>
  if (typeof document !== 'undefined') {
    function updateDashboard() {
      try {
        // Chapters
        const chapStored = localStorage.getItem('rh-guide-completed-chapters');
        const chapList = chapStored ? JSON.parse(chapStored) : [];
        const chapCount = chapList.length;
        const chapPct = Math.round((chapCount / 66) * 100);

        const chDone = document.getElementById('chaptersDoneText');
        const chBar = document.getElementById('chaptersProgressBar');
        const chPct = document.getElementById('chaptersPercentText');

        if (chDone) chDone.textContent = String(chapCount);
        if (chBar) chBar.style.width = `${chapPct}%`;
        if (chPct) chPct.textContent = `${chapPct}%`;

        // Nodes
        const nodeStored = localStorage.getItem('rh-guide-completed-nodes');
        const nodeList = nodeStored ? JSON.parse(nodeStored) : [];
        const nodeCount = nodeList.length;
        const nodePct = Math.round((nodeCount / 236) * 100);

        const nodeDone = document.getElementById('nodesDoneText');
        const nodeBar = document.getElementById('nodesProgressBar');
        const nodePctText = document.getElementById('nodesPercentText');

        if (nodeDone) nodeDone.textContent = String(nodeCount);
        if (nodeBar) nodeBar.style.width = `${nodePct}%`;
        if (nodePctText) nodePctText.textContent = `${nodePct}%`;
      } catch (err) {
        console.error('Failed to sync progress dashboard', err);
      }
    }

    updateDashboard();
    window.addEventListener('storage', updateDashboard);
    window.addEventListener('rh-progress-updated', updateDashboard);
  }
</script>
